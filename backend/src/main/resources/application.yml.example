server:
  port: 8220

spring:
  application:
    name: lab-twin
  profiles:
    active: dev
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/ruoyi7?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: your_password
    hikari:
      maximum-pool-size: 20
      minimum-idle: 5
  data:
    redis:
      host: localhost
      port: 6379
      database: 0
      timeout: 3000ms

mybatis-plus:
  mapper-locations: classpath*:mapper/**/*.xml
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.slf4j.Slf4jImpl
  global-config:
    db-config:
      id-type: assign_id

lab:
  clickhouse:
    enabled: false
    url: jdbc:clickhouse://localhost:8123/lab_dw
    username: default
    password: ""
  sync:
    interval-ms: 60000
    enabled: false
  cache:
    ttl-seconds: 30
  realtime:
    enabled: false
    interval-ms: 5000

logging:
  level:
    com.lab.twin: info
